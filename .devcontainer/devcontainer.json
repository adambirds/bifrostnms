{
  "name": "BifrostNMS Dev Container",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "version": "22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/go:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "charliermarsh.ruff",
        "golang.go",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "stylelint.vscode-stylelint",
        "ms-vscode.vscode-typescript-next",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "github.remotehub",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "codezombiech.gitignore",
        "ms-vscode.vscode-json",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "jock.svg",
        "unifiedjs.vscode-mdx",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true
        },
        "editor.codeActionsOnSave": { "source.organizeImports": "explicit" },
        "files.exclude": { "**/__pycache__": true, "**/*.pyc": true }
      }
    }
  },
  "forwardPorts": [8000, 3000, 3001, 3002, 5432, 6379],
  "portsAttributes": {
    "8000": { "label": "BifrostNMS API", "onAutoForward": "notify" },
    "3000": { "label": "BifrostNMS Dashboard", "onAutoForward": "notify" },
    "3001": { "label": "BifrostNMS Auth", "onAutoForward": "notify" },
    "3002": { "label": "BifrostNMS Website", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/link-host-git-config.sh",
  "remoteUser": "root",
  "remoteEnv": {
    "VIRTUAL_ENV": "/opt/venv",
    "PATH": "/opt/venv/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
    "source=vscode-server-extensions,target=/root/.vscode-server/extensions,type=volume",
    "source=bifrostnms-bash-history,target=/root/.history,type=volume",
    "source=${localEnv:HOME}/.codex,target=${localEnv:HOME}/.codex,type=bind,consistency=cached",
    // Codex's IPC socket stays per container; the host app has its own there.
    "source=codex-ipc,target=${localEnv:HOME}/.codex/ipc,type=volume",
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind,consistency=cached",
    "source=bifrostnms-github-cli-config,target=/root/.config/gh,type=volume",
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localEnv:HOME},target=/host-home,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "${localEnv:HOME}/.claude",
    "CODEX_HOME": "${localEnv:HOME}/.codex"
  }
}
