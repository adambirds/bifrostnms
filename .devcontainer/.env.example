DATABASE_URL=postgres://bifrostnms:bifrostnms@postgres:5432/bifrostnms
REDIS_URL=redis://redis:6379/0
BIFROSTNMS_ENV=development
BIFROSTNMS_DATABASE_URL=postgres://bifrostnms:bifrostnms@postgres:5432/bifrostnms
BIFROSTNMS_REDIS_URL=redis://redis:6379/0
BIFROSTNMS_CELERY_BROKER_URL=redis://redis:6379/1
BIFROSTNMS_CELERY_RESULT_BACKEND=redis://redis:6379/2
BIFROSTNMS_CELERY_TASK_ALWAYS_EAGER=false
BIFROSTNMS_AUTO_CREATE_SCHEMA=false
BIFROSTNMS_COOKIE_SECURE=false
BIFROSTNMS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BIFROSTNMS_SESSION_TTL_DAYS=30
BIFROSTNMS_AUTH_ENCRYPTION_KEY=development-only-change-me
BIFROSTNMS_AUTH_FRONTEND_URL=http://localhost:3001
BIFROSTNMS_EMAIL_VERIFICATION_TTL_HOURS=24
BIFROSTNMS_PASSWORD_RESET_TTL_MINUTES=30
BIFROSTNMS_WEBAUTHN_RP_ID=localhost
BIFROSTNMS_WEBAUTHN_RP_NAME=BifrostNMS
BIFROSTNMS_WEBAUTHN_ORIGIN=http://localhost:3001

# Email backend: smtp or microsoft_graph
BIFROSTNMS_EMAIL_BACKEND=smtp

# SMTP. Leave username/password unset for an unauthenticated relay.
BIFROSTNMS_SMTP_HOST=localhost
BIFROSTNMS_SMTP_PORT=25
BIFROSTNMS_SMTP_SECURITY=none
BIFROSTNMS_SMTP_TIMEOUT_SECONDS=15
# BIFROSTNMS_SMTP_USERNAME=
# BIFROSTNMS_SMTP_PASSWORD=
BIFROSTNMS_SMTP_FROM_EMAIL=bifrostnms@localhost
BIFROSTNMS_SMTP_FROM_NAME=BifrostNMS

# Microsoft Graph app-only email using certificate authentication.
# Set BIFROSTNMS_EMAIL_BACKEND=microsoft_graph to enable it.
# The Entra app registration requires Microsoft Graph application permission Mail.Send
# with administrator consent. Prefer constraining the app to the sender mailbox in Entra/Exchange.
# BIFROSTNMS_MICROSOFT_GRAPH_TENANT_ID=
# BIFROSTNMS_MICROSOFT_GRAPH_CLIENT_ID=
# BIFROSTNMS_MICROSOFT_GRAPH_SENDER_EMAIL=
# BIFROSTNMS_MICROSOFT_GRAPH_FROM_NAME=BifrostNMS
# BIFROSTNMS_MICROSOFT_GRAPH_TIMEOUT_SECONDS=15
# Supply certificate/private key either as base64-encoded PEM values...
# BIFROSTNMS_MICROSOFT_GRAPH_CERTIFICATE_BASE64=
# BIFROSTNMS_MICROSOFT_GRAPH_PRIVATE_KEY_BASE64=
# ...or as mounted PEM file paths.
# BIFROSTNMS_MICROSOFT_GRAPH_CERTIFICATE_PATH=/run/secrets/bifrostnms-graph.crt
# BIFROSTNMS_MICROSOFT_GRAPH_PRIVATE_KEY_PATH=/run/secrets/bifrostnms-graph.key
# BIFROSTNMS_MICROSOFT_GRAPH_PRIVATE_KEY_PASSPHRASE=
