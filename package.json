{
  "name": "bifrostnms",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:auth": "pnpm --dir auth-frontend dev",
    "dev:website": "pnpm --dir website dev",
    "build:frontend": "pnpm --dir frontend build",
    "build:auth": "pnpm --dir auth-frontend build",
    "build:website": "pnpm --dir website build",
    "lint": "pnpm --dir frontend lint && pnpm --dir auth-frontend lint && pnpm --dir website lint",
    "typecheck": "pnpm --dir frontend typecheck && pnpm --dir auth-frontend typecheck && pnpm --dir website typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^37.0.0",
    "typescript-eslint": "^8.39.0"
  }
}
