{
  "name": "bifrostnms",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:auth": "pnpm --dir auth-frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "build:auth": "pnpm --dir auth-frontend build",
    "lint": "pnpm --dir frontend lint && pnpm --dir auth-frontend lint",
    "typecheck": "pnpm --dir frontend typecheck && pnpm --dir auth-frontend typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "stylelint": "latest",
    "stylelint-config-standard": "latest",
    "typescript-eslint": "latest"
  }
}
