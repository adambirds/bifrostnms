#!/bin/bash
set -u

FAILED_COMPONENTS=()

echo "🧪 Running all BifrostNMS tests..."
echo ""

echo "📊 Backend (FastAPI)..."
if pytest backend; then
	echo "✅ Backend tests passed"
else
	echo "❌ Backend tests failed"
	FAILED_COMPONENTS+=("Backend")
fi
echo ""

echo "🌐 Dashboard (Next.js)..."
if pnpm --dir frontend typecheck && pnpm --dir frontend lint; then
	echo "✅ Dashboard checks passed"
else
	echo "❌ Dashboard checks failed"
	FAILED_COMPONENTS+=("Dashboard")
fi
echo ""

echo "🔐 Auth frontend (Next.js)..."
if pnpm --dir auth-frontend typecheck && pnpm --dir auth-frontend lint; then
	echo "✅ Auth frontend checks passed"
else
	echo "❌ Auth frontend checks failed"
	FAILED_COMPONENTS+=("Auth frontend")
fi
echo ""

echo "🛰️  Agent (Go)..."
if (cd agent && go test ./... && go vet ./...); then
	echo "✅ Agent tests passed"
else
	echo "❌ Agent tests failed"
	FAILED_COMPONENTS+=("Agent")
fi
echo ""

if [ ${#FAILED_COMPONENTS[@]} -eq 0 ]; then
	echo "🎉 All tests passed!"
	exit 0
fi

echo "❌ Failed components: ${FAILED_COMPONENTS[*]}"
exit 1
