FROM python:3.12-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends fping dnsutils curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements/prod.in /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY backend/ /app/
EXPOSE 8000
CMD ["uvicorn", "bifrostnms.main:app", "--host", "0.0.0.0", "--port", "8000"]
